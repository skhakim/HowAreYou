# Copy to .env and fill in. Never commit .env.

# Signs login tokens (JWT) and sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local development; docker-compose overrides the host with `db`.
DATABASE_URL=postgresql://postgres:postgres@localhost/mhst

# Set to 1 only on your own machine (enables the Flask debugger).
FLASK_DEBUG=0

# Google Calendar (only needed to create consultation events)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
